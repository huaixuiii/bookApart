page {
  background: #f7f4ee;
  color: #24302f;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

button {
  border-radius: 999rpx;
}

.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}

.empty-state {
  margin: 160rpx 40rpx 0;
  padding: 64rpx 40rpx;
  border-radius: 36rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 18rpx 48rpx rgba(40, 48, 47, 0.08);
}

.empty-title {
  font-size: 38rpx;
  font-weight: 700;
}

.empty-desc {
  margin-top: 16rpx;
  color: #7f8b88;
  font-size: 28rpx;
  line-height: 1.6;
}
