.page {
  min-height: 100vh;
}

.media-swiper {
  height: 560rpx;
  background: #dbe5de;
}

.media-swiper image,
.media-swiper video {
  width: 100%;
  height: 100%;
}

.media-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #66736f;
}

.content-card {
  margin: -38rpx 24rpx 120rpx;
  padding: 34rpx;
  border-radius: 38rpx;
  background: #fff;
  box-shadow: 0 20rpx 54rpx rgba(37, 48, 47, 0.1);
}

.top-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
}

.price {
  color: #d35c35;
  font-size: 44rpx;
  font-weight: 800;
}

.title {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.status {
  flex-shrink: 0;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #eef4ef;
  color: #27433f;
  line-height: 56rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 32rpx;
}

.info-grid view {
  padding: 20rpx;
  border-radius: 24rpx;
  background: #f6f3ee;
  font-size: 27rpx;
}

.info-grid text {
  display: block;
  margin-bottom: 8rpx;
  color: #87918e;
  font-size: 23rpx;
}

.section {
  margin-top: 34rpx;
}

.section-title {
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.tag {
  display: inline-flex;
  margin: 0 12rpx 12rpx 0;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.tag.good {
  background: #edf7ef;
}

.tag.bad {
  background: #fff0ea;
}

.note,
.extra,
.muted {
  color: #697672;
  font-size: 27rpx;
  line-height: 1.7;
}

.extra {
  margin-top: 30rpx;
}

.actions {
  position: fixed;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  left: 24rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.actions button {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}

.primary {
  color: #fff;
  background: #27433f;
}

.secondary {
  color: #d35c35;
  background: #fff;
}
