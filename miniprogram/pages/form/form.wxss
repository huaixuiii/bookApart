.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.form-card {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(37, 48, 47, 0.07);
}

.section-title {
  margin-bottom: 22rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.media-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.thumb,
.upload {
  position: relative;
  overflow: hidden;
  height: 188rpx;
  border-radius: 22rpx;
  background: #f3f1ec;
}

.thumb image,
.thumb video {
  width: 100%;
  height: 100%;
}

.upload {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #63706c;
  font-size: 27rpx;
}

.remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  text-align: center;
  line-height: 42rpx;
}

.hint {
  margin-top: 14rpx;
  color: #8b948f;
  font-size: 24rpx;
}

input,
textarea,
.picker {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 18rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f6f3ee;
  font-size: 28rpx;
}

textarea {
  min-height: 160rpx;
}

.two-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.save {
  margin: 30rpx 0 12rpx;
  height: 92rpx;
  line-height: 92rpx;
  color: #fff;
  background: #27433f;
  font-size: 32rpx;
  font-weight: 700;
}
