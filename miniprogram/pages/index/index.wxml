<view class="page safe-bottom">
  <view class="hero">
    <view class="eyebrow">口岸租房 · 轻量记录</view>
    <view class="title">我的房源卡片</view>
    <view class="summary">共 {{stats.total}} 套，{{stats.liked}} 套喜欢，{{stats.visited}} 套已看，{{stats.eliminated}} 套淘汰</view>
  </view>

  <view class="search-bar">
    <input
      placeholder="搜标题、小区、位置、通勤"
      value="{{keyword}}"
      bindinput="onKeywordInput"
      bindconfirm="searchListings"
    />
    <button wx:if="{{keyword}}" class="ghost" bindtap="clearKeyword">清空</button>
    <button class="primary-mini" bindtap="searchListings">搜索</button>
  </view>

  <scroll-view class="status-tabs" scroll-x>
    <view
      wx:for="{{statusTabs}}"
      wx:key="*this"
      class="status-tab {{activeStatus === item ? 'active' : ''}}"
      data-status="{{item}}"
      bindtap="switchStatus"
    >{{item}}</view>
  </scroll-view>

  <scroll-view class="sort-tabs" scroll-x>
    <view
      wx:for="{{sortOptions}}"
      wx:key="*this"
      class="sort-tab {{activeSort === item ? 'active' : ''}}"
      data-sort="{{item}}"
      bindtap="switchSort"
    >{{item}}</view>
  </scroll-view>

  <block wx:if="{{listings.length}}">
    <swiper class="listing-swiper" current="{{currentIndex}}" bindchange="onSwiperChange" duration="240">
      <swiper-item wx:for="{{listings}}" wx:key="_id">
        <view class="card" data-id="{{item._id}}" bindtap="goDetail">
          <view class="cover {{item.coverUrl ? '' : 'empty-cover'}}">
            <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" />
            <view wx:else class="cover-placeholder">暂无图片</view>
            <view class="status-pill">{{item.status}}</view>
          </view>
          <view class="card-body">
            <view class="price">{{item.price || '价格待补充'}}</view>
            <view class="name">{{item.title || item.community || '未命名房源'}}</view>
            <view class="meta">
              <text>{{item.location || '位置待补充'}}</text>
              <text>{{item.community}}</text>
            </view>
            <view class="facts">
              <view>{{item.layout || '户型待补充'}}</view>
              <view>{{item.area || '面积待补充'}}</view>
              <view>{{item.commute || '通勤待补充'}}</view>
            </view>
            <view class="quick-review">
              <view class="review-block good">
                <view class="review-title">优点</view>
                <view>{{item.pros[0] || '还没记录'}}</view>
              </view>
              <view class="review-block bad">
                <view class="review-title">缺点</view>
                <view>{{item.cons[0] || '还没记录'}}</view>
              </view>
            </view>
          </view>
        </view>
      </swiper-item>
    </swiper>
    <view class="counter">{{currentIndex + 1}} / {{listings.length}}</view>
  </block>

  <view wx:else class="empty-state">
    <view class="empty-title">还没有房源</view>
    <view class="empty-desc">先记录第一套，看图、优缺点和通勤都放在一张卡里。</view>
    <button class="primary" bindtap="goCreate">添加第一套</button>
  </view>

  <button class="floating-add" bindtap="goCreate">＋</button>
</view>
