.page {
  min-height: 100vh;
  padding: 36rpx 28rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.eyebrow {
  color: #8b948f;
  font-size: 24rpx;
}

.title {
  margin-top: 8rpx;
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.add-small {
  margin: 0;
  padding: 0 30rpx;
  height: 72rpx;
  line-height: 72rpx;
  color: #fff;
  background: #27433f;
  font-size: 28rpx;
}

.status-tabs {
  margin: 34rpx -28rpx 24rpx;
  padding-left: 28rpx;
  white-space: nowrap;
}

.status-tab {
  display: inline-flex;
  margin-right: 16rpx;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #7b8581;
  font-size: 26rpx;
}

.status-tab.active {
  background: #27433f;
  color: #fff;
}

.listing-swiper {
  height: 1040rpx;
}

.card {
  overflow: hidden;
  height: 1000rpx;
  border-radius: 44rpx;
  background: #fff;
  box-shadow: 0 24rpx 60rpx rgba(37, 48, 47, 0.12);
}

.cover {
  position: relative;
  height: 460rpx;
  background: linear-gradient(135deg, #dde7df, #c4d4cb);
}

.cover image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #64736f;
  font-size: 30rpx;
}

.status-pill {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #27433f;
  font-size: 24rpx;
  font-weight: 700;
}

.card-body {
  padding: 34rpx;
}

.price {
  color: #d35c35;
  font-size: 46rpx;
  font-weight: 800;
}

.name {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.meta {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
  color: #76827e;
  font-size: 26rpx;
}

.facts {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 30rpx;
}

.facts view {
  padding: 18rpx 12rpx;
  border-radius: 22rpx;
  background: #f4f1eb;
  text-align: center;
  color: #45514e;
  font-size: 24rpx;
}

.quick-review {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 30rpx;
}

.review-block {
  min-height: 120rpx;
  padding: 20rpx;
  border-radius: 26rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.review-block.good {
  background: #edf7ef;
}

.review-block.bad {
  background: #fff0ea;
}

.review-title {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.counter {
  margin-top: 16rpx;
  text-align: center;
  color: #8b948f;
  font-size: 26rpx;
}

.primary {
  margin-top: 36rpx;
  width: 280rpx;
  color: #fff;
  background: #27433f;
}

.floating-add {
  position: fixed;
  right: 32rpx;
  bottom: calc(env(safe-area-inset-bottom) + 34rpx);
  width: 104rpx;
  height: 104rpx;
  line-height: 104rpx;
  border-radius: 50%;
  color: #fff;
  background: #d35c35;
  font-size: 56rpx;
  box-shadow: 0 16rpx 40rpx rgba(211, 92, 53, 0.35);
}
