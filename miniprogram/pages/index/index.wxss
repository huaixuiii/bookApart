.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 120rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f8f4ee 0%, #fbfaf7 48%, #f4efe7 100%);
}

.hero {
  padding: 12rpx 0 24rpx;
}

.eyebrow {
  color: #8f8a82;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.title {
  margin-top: 8rpx;
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.summary {
  margin-top: 10rpx;
  color: #74807b;
  font-size: 24rpx;
}

.search-bar {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin: 18rpx 0 16rpx;
}

.search-bar input {
  flex: 1;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #fff;
  box-sizing: border-box;
}

.ghost,
.primary-mini {
  margin: 0;
  padding: 0 22rpx;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
}

.ghost {
  color: #5e6662;
  background: #ece8df;
}

.primary-mini {
  color: #fff;
  background: #27433f;
}

.status-tabs,
.sort-tabs {
  margin: 18rpx -28rpx 18rpx;
  padding-left: 28rpx;
  white-space: nowrap;
}

.sort-tabs {
  margin-top: 0;
}

.status-tab,
.sort-tab {
  display: inline-flex;
  margin-right: 16rpx;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #7b8581;
  font-size: 26rpx;
}

.status-tab.active,
.sort-tab.active {
  background: #27433f;
  color: #fff;
}

.listing-swiper {
  height: 1040rpx;
}

.card {
  overflow: hidden;
  height: 1000rpx;
  border-radius: 44rpx;
  background: #fff;
  box-shadow: 0 24rpx 60rpx rgba(37, 48, 47, 0.12);
}

.cover {
  position: relative;
  height: 460rpx;
  background: linear-gradient(135deg, #dde7df, #c4d4cb);
}

.cover image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #64736f;
  font-size: 30rpx;
}

.status-pill {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #27433f;
  font-size: 24rpx;
  font-weight: 700;
}

.card-body {
  padding: 34rpx;
}

.price {
  color: #d35c35;
  font-size: 46rpx;
  font-weight: 800;
}

.name {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.meta {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
  color: #76827e;
  font-size: 26rpx;
}

.facts {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 30rpx;
}

.facts view {
  padding: 18rpx 12rpx;
  border-radius: 22rpx;
  background: #f4f1eb;
  text-align: center;
  color: #45514e;
  font-size: 24rpx;
}

.quick-review {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 30rpx;
}

.review-block {
  min-height: 120rpx;
  padding: 20rpx;
  border-radius: 26rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.review-block.good {
  background: #edf7ef;
}

.review-block.bad {
  background: #fff0ea;
}

.review-title {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.counter {
  margin-top: 16rpx;
  text-align: center;
  color: #8b948f;
  font-size: 26rpx;
}

.empty-state {
  margin-top: 140rpx;
  text-align: center;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 800;
}

.empty-desc {
  margin-top: 16rpx;
  color: #73807c;
  font-size: 26rpx;
}

.primary {
  margin-top: 36rpx;
  width: 280rpx;
  color: #fff;
  background: #27433f;
}

.floating-add {
  position: fixed;
  right: 32rpx;
  bottom: calc(env(safe-area-inset-bottom) + 34rpx);
  width: 104rpx;
  height: 104rpx;
  line-height: 104rpx;
  border-radius: 50%;
  color: #fff;
  background: #d35c35;
  font-size: 56rpx;
  box-shadow: 0 16rpx 40rpx rgba(211, 92, 53, 0.35);
}
